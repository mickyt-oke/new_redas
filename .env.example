APP_NAME="NIS-REDAS"
APP_ENV=local
APP_KEY=

# Salt used to obfuscate integer IDs in URLs (Hashids). Generate a long random
# string per environment; rotating it invalidates previously issued links.
HASHID_SALT=

APP_DEBUG=true
APP_URL=https://nis-redas.laravel.cloud
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# ----------------------------------------------------------------------
# Database — MySQL is the production default; SQLite is used for tests.
# Copying this file creates a LOCAL environment. Production deploys must
# override APP_ENV=production, APP_DEBUG=false, and use a dedicated DB user.
# ----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redas_new
DB_USERNAME=redas_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# DB_URL=
# DB_SOCKET=

# ----------------------------------------------------------------------
# Session / Cache / Queue — database-backed by default.
# ----------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Comma-separated list of trusted proxy IPs/ranges. Leave empty to trust none.
TRUSTED_PROXIES=
# To store sessions in Redis (with the TLS connection above), set:
# SESSION_DRIVER=redis
# SESSION_CONNECTION=default
# SESSION_STORE=

# Failover uses Redis for speed and falls back to the database cache table
# if Redis is unreachable. This keeps login/MFA alive during Redis outages.
CACHE_STORE=failover
CACHE_PREFIX=nis-redas-cache-
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=

QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

# ----------------------------------------------------------------------
# Redis — configured for Upstash Redis (TLS required)
# ----------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST="<YOUR_UPSTASH_ENDPOINT>"      # do not include tls:// here; set REDIS_SSL=true below
REDIS_PORT=6379
REDIS_PASSWORD="<YOUR_UPSTASH_TOKEN>"
REDIS_USERNAME=
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_PREFIX=nis-redas-database-
REDIS_SSL=true
REDIS_SSL_VERIFY_PEER=true
REDIS_SSL_VERIFY_PEER_NAME=true
REDIS_SSL_ALLOW_SELF_SIGNED=false
# REDIS_SSL_CAFILE=/path/to/ca-bundle.crt

# ----------------------------------------------------------------------
# Mail — Resend SMTP is the production default.
# ----------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME="${RESEND_API_KEY}"
MAIL_PASSWORD="${RESEND_API_KEY}"
MAIL_FROM_ADDRESS=noreply@nis.gov.ng
MAIL_FROM_NAME="NIS-REDAS"
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=
# MAIL_URL=

RESEND_API_KEY=

# ----------------------------------------------------------------------
# Sanctum API authentication.
# ----------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_PREFIX=
SANCTUM_ACCESS_TTL=900
SANCTUM_REFRESH_TTL=2592000

# ----------------------------------------------------------------------
# OTP / magic-link token lifetimes (seconds).
# ----------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
AUTH_TOKEN_TTL_SECONDS=3600

# ----------------------------------------------------------------------
# Session hardening.
# ----------------------------------------------------------------------
SESSION_FINGERPRINT_ENFORCED=true
AUTH_COOKIE_SECURE=

# Content-Security-Policy enforcement switch. Keep false in local/staging to
# collect violation reports; set true in production after triage.
CSP_ENFORCE=false

# ----------------------------------------------------------------------
# Logging / filesystem.
# ----------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------
# Tuning.
# ----------------------------------------------------------------------
BCRYPT_ROUNDS=12

HASHID_SALT=
