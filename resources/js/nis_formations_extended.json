  "source_notes": {
    "current_nis_organogram": "NIS Organogram publicly identifies Zonal Offices, State Commands, Passport/OTD, Airport Commands, Seaport/Marine Commands, Land Border Commands, Area Offices and Local Government Immigration Offices.",
    "national_border_management_strategy": "The NIS National Border Management Strategy 2019-2023 documented 1 Service Headquarters, 8 Zonal Commands, 45 Commands, 774 Local Government Immigration Offices, 42 Passport Offices, 36 CERPAC Centres, 84 operational Land Border Control Posts, 111 Border Patrol Bases, 5 Airport Border Control locations, 7 Seaport Control locations, 9 Marine Patrol Bases, 7 Air Main/Forward Operating Bases and 3 Passport Front-end Desks.",
    "verification_status": "Counts in the strategy are historical and should not automatically be treated as the definitive 2026 establishment strength.",
    "recommended_system_field": "Each formation should have a status field such as ACTIVE, INACTIVE, PROPOSED, UNDER_CONSTRUCTION or VERIFY."
  }
